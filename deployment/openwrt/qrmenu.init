#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1
start_service() {
 [ -d /mnt/qrmenu/data ] || { logger -t qrmenu 'Falta el almacenamiento /mnt/qrmenu'; return 1; }
 procd_open_instance
 procd_set_param command /opt/qrmenu/qrmenu --ui /opt/qrmenu/ui --data /mnt/qrmenu/data --public-key /etc/qrmenu/seller-public.txt --listen :8080 --admin :8443 --cert-ips 192.168.8.1,192.168.50.1
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
