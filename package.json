{
  "name": "qr-menu-ec",
  "version": "0.8.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "test": "tsx --test tests/*.test.ts",
    "test:firebase": "firebase emulators:exec --only firestore --project demo-qr-menu-ec \"node --test tests/firebase-rules.test.mjs\"",
    "test:firestore": "firebase emulators:exec --config firebase.step4.json --only firestore --project demo-qr-menu-ec \"node --import tsx --test --test-concurrency=1 tests/firebase-rules.test.mjs tests/firestore-repositories.test.ts tests/firestore-notifications.test.ts tests/backup-drill.test.ts\"",
    "test:backup-drill": "node scripts/backup-monthly-drill.mjs",
    "build:worker": "vite build --config vite.worker.config.ts",
    "check": "tsc --noEmit",
    "db:local": "wrangler d1 execute site-creator-d1 --local --config wrangler.local.json --file drizzle/0000_even_inhumans.sql",
    "build:pages": "vite build --config vite.pages.config.ts && node scripts/prepare-pages.mjs",
    "dev:pages": "npm run build:pages && vite preview --config vite.pages.config.ts --host 127.0.0.1 --port 4173",
    "preview:pages": "vite preview --config vite.pages.config.ts --host 127.0.0.1 --port 4173",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist-pages --project-name qr-menu-ec --branch main",
    "test:pages": "node scripts/pages-qa.mjs",
    "test:production": "node scripts/production-smoke.mjs",
    "test:experience": "tsx scripts/experience-qa.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "embla-carousel-react": "8.6.0",
    "firebase": "^12.19.0",
    "input-otp": "1.5.0",
    "jose": "^6.2.12",
    "lucide-react": "1.52.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "4.14.2",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.2",
    "@cloudflare/workers-types": "5.20260927.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "braces": "file:vendor/braces",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "firebase-tools": "^15.31.0",
    "jsqr": "^1.4.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.2.2",
    "wrangler": "4.141.0"
  },
  "type": "module",
  "overrides": {
    "sharp": "$sharp",
    "braces": "$braces",
    "undici": "7.29.1",
    "@grpc/grpc-js": "1.13.6",
    "basic-ftp": "6.2.1",
    "tinypool": "2.1.2"
  }
}
