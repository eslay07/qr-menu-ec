{
  "name": "qr-menu-ec",
  "version": "0.8.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "test": "tsx --test tests/*.test.ts",
    "build:worker": "vite build --config vite.worker.config.ts",
    "check": "tsc --noEmit",
    "db:local": "wrangler d1 execute site-creator-d1 --local --config wrangler.local.json --file drizzle/0000_even_inhumans.sql",
    "build:pages": "vite build --config vite.pages.config.ts && node scripts/prepare-pages.mjs",
    "dev:pages": "npm run build:pages && vite preview --config vite.pages.config.ts --host 127.0.0.1 --port 4173",
    "preview:pages": "vite preview --config vite.pages.config.ts --host 127.0.0.1 --port 4173",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist-pages --project-name qr-menu-ec --branch main",
    "test:pages": "node scripts/pages-qa.mjs",
    "test:production": "node scripts/production-smoke.mjs",
    "test:experience": "tsx scripts/experience-qa.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.48.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "4.13.3",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "3.10.1",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.2",
    "@cloudflare/workers-types": "5.20260927.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "jsqr": "^1.4.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "^0.35.4",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "4.141.0"
  },
  "type": "module",
  "overrides": {
    "undici": "7.29.0"
  }
}
