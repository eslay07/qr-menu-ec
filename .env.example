LICENSE_PUBLIC_KEY=
SETUP_TOKEN=
PLATFORM_MENU_DOMAIN=menus.example.com
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CNAME_TARGET=customers.menus.example.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_SUBDOMAIN=consola
CORE_WORKER_SERVICE=qr-menu-ec
DATA_ENCRYPTION_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
CREATOR_RECOVERY_EMAIL=
PUBLIC_APP_ORIGIN=https://qr-menu-ec.consola.workers.dev

# Firebase web app: Project settings > General > Your apps > Web > SDK config.
# Public client identifiers ONLY. Never put Admin SDK credentials in VITE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only auth migration. Keep legacy until staging and secret provisioning pass.
AUTH_PROVIDER=legacy
FIREBASE_PROJECT_ID=qr-menu-6981a
FIREBASE_API_KEY=
# Set FIREBASE_SERVICE_ACCOUNT with Worker secrets; never place it in VITE_* or Git.
# Server-only. Leave blank until a domain you control is verified for sending.
MAIL_DOMAIN=
MAIL_SANDBOX=false
MAIL_SANDBOX_TO=

# Photos remain in R2. Storage migration is deferred by explicit user decision.
MEDIA_PROVIDER=legacy
FIREBASE_STORAGE_ENABLED=false
FIREBASE_STORAGE_PROJECT_ID=qr-menu-6981a
FIREBASE_STORAGE_BUCKET=qr-menu-6981a.firebasestorage.app
# FIREBASE_STORAGE_SERVICE_ACCOUNT: Worker secret, separate from Authentication.

# Push stays disabled until end-to-end acceptance; never put the FCM server key here.
FCM_ENABLED=false
VITE_FCM_ENABLED=false
VITE_FIREBASE_VAPID_KEY=
# FIREBASE_FCM_SERVICE_ACCOUNT: independent Worker secret (firebase.messaging scope).
